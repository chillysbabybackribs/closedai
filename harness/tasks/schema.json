{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ClosedAI simulation task catalog",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "tool", "replay", "oracle"],
    "properties": {
      "id": { "type": "string" },
      "tool": { "type": "string" },
      "intent": { "type": "string" },
      "fixture": { "type": "string" },
      "replay": {
        "type": "array",
        "minItems": 1,
        "items": { "$ref": "#/$defs/toolCall" }
      },
      "oracle": { "$ref": "#/$defs/oracle" },
      "variations": {
        "type": "object",
        "additionalProperties": {
          "type": "array",
          "minItems": 1
        }
      },
      "tags": { "type": "array", "items": { "type": "string" } },
      "source": { "type": "string" }
    },
    "additionalProperties": false
  },
  "$defs": {
    "toolCall": {
      "type": "object",
      "required": ["namespace", "tool", "arguments"],
      "properties": {
        "namespace": { "type": "string" },
        "tool": { "type": "string" },
        "arguments": { "type": "object" }
      },
      "additionalProperties": false
    },
    "oracle": {
      "type": "object",
      "properties": {
        "must_call": { "type": "array", "items": { "$ref": "#/$defs/mustCall" } },
        "must_not_call": { "type": "array", "items": { "$ref": "#/$defs/toolCall" } },
        "max_tool_calls": { "type": "integer", "minimum": 1 },
        "expect_success": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "mustCall": {
      "allOf": [
        { "$ref": "#/$defs/toolCall" },
        {
          "type": "object",
          "properties": {
            "partialArgs": { "type": "boolean" }
          }
        }
      ]
    }
  }
}
