{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ClosedAI live app evaluation tasks",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "title", "user", "observe"],
    "properties": {
      "id": { "type": "string", "pattern": "^[a-z0-9_-]+$" },
      "title": { "type": "string" },
      "user": { "type": "string", "minLength": 1 },
      "provider": {
        "type": "string",
        "enum": ["cursor", "codex", "claude", "antigravity"]
      },
      "modelId": { "type": "string" },
      "setup": {
        "type": "object",
        "properties": {
          "browserUrl": { "type": "string" },
          "revealBrowser": { "type": "boolean" }
        },
        "additionalProperties": false
      },
      "observe": {
        "type": "array",
        "minItems": 1,
        "items": { "type": "string", "minLength": 1 }
      },
      "tags": { "type": "array", "items": { "type": "string" } }
    },
    "additionalProperties": false
  }
}
