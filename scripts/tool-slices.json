{
  "version": 1,
  "codexEagerWireCap": 7800,
  "slices": {
    "selfdev": {
      "label": "Host app repo work",
      "description": "Self-development in the ClosedAI checkout: eager app, batch, and search helpers; native file tools for edits.",
      "resetEager": true,
      "cursorNamespaces": [
        "closedai_app",
        "search",
        "peer_chats",
        "tool_batch",
        "closedai_ui"
      ],
      "promotePriority": [
        "closedai_app.state",
        "tool_batch.run",
        "search.query",
        "closedai_ui.capture",
        "closedai_app.command",
        "peer_chats.recall"
      ]
    },
    "core": {
      "label": "Default workspace",
      "description": "Operate the app, recall context, single-shot search — no browser/CDP/native.",
      "resetEager": true,
      "cursorNamespaces": [
        "closedai_app",
        "search",
        "peer_chats",
        "tool_batch"
      ],
      "promotePriority": [
        "closedai_app.state",
        "peer_chats.recall",
        "peer_chats.search",
        "peer_chats.spine",
        "search.query",
        "peer_chats.list",
        "closedai_app.command",
        "tool_batch.run"
      ]
    },
    "browser": {
      "label": "Embedded browser",
      "description": "Read and script the shared browser tab plus app state.",
      "resetEager": true,
      "cursorNamespaces": [
        "embedded_browser",
        "site",
        "browser_cdp",
        "closedai_app",
        "search",
        "closedai_ui",
        "tool_batch"
      ],
      "promotePriority": [
        "embedded_browser.page",
        "closedai_app.state",
        "tool_batch.run",
        "embedded_browser.session",
        "embedded_browser.session.fetch_many",
        "browser_cdp.capture_spa",
        "embedded_browser.script",
        "site.discover.bootstrap",
        "search.query"
      ]
    },
    "research": {
      "label": "Web research",
      "description": "Search APIs and research runs; app state for layout.",
      "resetEager": true,
      "cursorNamespaces": [
        "closedai_app",
        "search",
        "site",
        "embedded_browser",
        "browser_cdp",
        "tool_batch",
        "peer_chats"
      ],
      "promotePriority": [
        "closedai_app.state",
        "embedded_browser.session",
        "embedded_browser.session.fetch_many",
        "site.discover.bootstrap",
        "tool_batch.run",
        "browser_cdp.capture_spa"
      ]
    },
    "full": {
      "label": "Discovery fallback",
      "description": "Registry default eager/defer flags; deferred tools load through provider discovery.",
      "resetEager": false,
      "promotePriority": []
    }
  },
  "signals": {
    "browser": { "slice": "browser", "when": "turn_has_browser_subject_or_active_tab" },
    "research": { "slice": "research", "when": "user_intent_research_heuristic" },
    "selfdev": { "slice": "selfdev", "when": "self_development_repo_work" },
    "default": { "slice": "core" }
  }
}
