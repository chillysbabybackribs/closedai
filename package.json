{
  "name": "closedai",
  "productName": "closedai",
  "version": "0.1.0",
  "description": "Embedded-Chromium browser shell with a persistent Codex app-server chat.",
  "main": "out/main/index.js",
  "type": "module",
  "private": true,
  "scripts": {
    "predev": "npm run hygiene",
    "dev": "node scripts/launch-electron-vite.mjs dev",
    "prebuild": "npm run hygiene",
    "build": "tsc --noEmit && electron-vite build",
    "preview": "node scripts/launch-electron-vite.mjs preview",
    "typecheck": "tsc --noEmit",
    "test:one": "node --experimental-transform-types --import ./scripts/ts-resolve-hook-register.mjs --test",
    "test": "node --experimental-transform-types --import ./scripts/ts-resolve-hook-register.mjs --test \"src/**/*.test.ts\" \"src/**/*.test.tsx\" --test-skip-pattern=\"\\.pilot\\.test\\.ts$\"",
    "test:pilot:workspace-ledger": "node --experimental-transform-types --import ./scripts/ts-resolve-hook-register.mjs --test \"src/main/chat-context/workspace-ledger-pilot/**/*.pilot.test.ts\"",
    "harness:pilot:workspace-ledger": "npm run test:pilot:workspace-ledger",
    "guide:generate": "node scripts/agent-guide-generate.mjs --write",
    "guide:check": "node scripts/agent-guide-generate.mjs --check",
    "closure": "node scripts/closure-gate.mjs",
    "hygiene": "node scripts/hygiene-gate.mjs",
    "ui-coverage": "node --disable-warning=ExperimentalWarning --experimental-transform-types --import ./scripts/ts-resolve-hook-register.mjs scripts/ui-coverage/cli.ts",
    "map": "node scripts/repo-tree.mjs --write",
    "map:check": "node scripts/repo-tree.mjs --check",
    "audit:docs": "node --experimental-transform-types --import ./scripts/ts-resolve-hook-register.mjs scripts/docs-telemetry-audit.ts",
    "browser:live": "node scripts/browser-live-check.mjs",
    "video:live": "node scripts/video-render-live-check.mjs",
    "search:pipeline": "node scripts/search-pipeline-live-check.mjs",
    "harness:replay": "node --experimental-transform-types --import ./scripts/ts-resolve-hook-register.mjs scripts/harness-sim/run.mjs",
    "harness:model": "node --experimental-transform-types --import ./scripts/ts-resolve-hook-register.mjs scripts/harness-sim/run.mjs --model",
    "harness:compare": "node --experimental-transform-types --import ./scripts/ts-resolve-hook-register.mjs scripts/harness-sim/run.mjs --compare",
    "harness:codex": "node --experimental-transform-types --import ./scripts/ts-resolve-hook-register.mjs scripts/harness-sim/run.mjs --model --adapter=codex --concurrency=1",
    "harness:prompt-sweep": "node --experimental-transform-types --import ./scripts/ts-resolve-hook-register.mjs scripts/harness-sim/prompt-sweep.mjs --adapter=codex --concurrency=2",
    "harness:extract": "node scripts/harness-sim/extract-from-tests.mjs",
    "harness:live": "node --experimental-transform-types --import ./scripts/ts-resolve-hook-register.mjs scripts/harness-sim/live-eval.mjs",
    "harness:orientation": "npm run test:one -- src/main/chat-context/c3-orientation-probes.test.ts",
    "check": "npm run map:check && npm run guide:check && npm test && npm run build && npm run closure",
    "autogit": "node scripts/autogit.mjs run",
    "autogit:once": "node scripts/autogit.mjs once",
    "autogit:status": "node scripts/autogit.mjs status",
    "autogit:install": "node scripts/autogit.mjs install",
    "autogit:uninstall": "node scripts/autogit.mjs uninstall"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.280",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@napi-rs/canvas": "1.0.0",
    "@tesseract.js-data/eng": "1.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "frida": "17.18.0",
    "lucide-react": "^1.33.0",
    "marked": "^18.0.11",
    "motion": "^13.4.2",
    "parse5": "^8.0.1",
    "pdfjs-dist": "6.3.289",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.4.3",
    "tailwind-merge": "^3.6.0",
    "tesseract.js": "7.0.0",
    "typescript": "^5.9.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.0.0",
    "electron-vite": "^5.0.0",
    "tailwindcss": "^4.3.3",
    "vite": "^7.3.6"
  }
}
