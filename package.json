{
  "name": "closedai",
  "productName": "closedai",
  "version": "0.1.0",
  "description": "Embedded-Chromium browser shell with a persistent Codex app-server chat.",
  "main": "out/main/index.js",
  "type": "module",
  "private": true,
  "scripts": {
    "predev": "npm run hygiene",
    "dev": "ELECTRON_DISABLE_SANDBOX=1 node scripts/launch-electron-vite.mjs dev",
    "dev:web": "vite --config web.vite.config.ts",
    "prebuild": "npm run hygiene",
    "build": "tsc --noEmit && electron-vite build",
    "preview": "ELECTRON_DISABLE_SANDBOX=1 node scripts/launch-electron-vite.mjs preview",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-transform-types --import ./scripts/ts-resolve-hook-register.mjs --test \"src/**/*.test.ts\"",
    "closure": "node scripts/closure-gate.mjs",
    "hygiene": "node scripts/hygiene-gate.mjs",
    "map": "node scripts/repo-tree.mjs --write",
    "map:check": "node scripts/repo-tree.mjs --check",
    "check": "npm run map:check && npm run hygiene && npm run typecheck && npm test && npm run build && npm run closure",
    "autogit": "node scripts/autogit.mjs run",
    "autogit:once": "node scripts/autogit.mjs once",
    "autogit:status": "node scripts/autogit.mjs status",
    "autogit:install": "node scripts/autogit.mjs install",
    "autogit:uninstall": "node scripts/autogit.mjs uninstall"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.258",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@radix-ui/react-use-controllable-state": "^1.2.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.33.0",
    "marked": "^18.0.11",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.12.3",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.4.3",
    "tailwind-merge": "^3.6.0",
    "use-stick-to-bottom": "^1.1.6",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.0.0",
    "electron-vite": "^5.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  }
}
